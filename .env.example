# Database (Supabase Postgres). DATABASE_URL is the pooled pgbouncer
# connection (port 6543, `?pgbouncer=true`) that every runtime query uses;
# DIRECT_URL is the direct connection (port 5432) `prisma migrate` needs,
# since migrations run DDL/advisory locks pgbouncer's transaction pooling
# mode doesn't support. Local dev / Docker Compose point both at the same
# local Postgres instance. See DEPLOYMENT.md for the full Supabase setup.
DATABASE_URL="postgresql://user:password@host:6543/film_studio_classroom_ai?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/film_studio_classroom_ai"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 33"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: restrict sign-in to a Google Workspace for Education domain
GOOGLE_WORKSPACE_DOMAIN=""

# Optional additional sign-in providers (Microsoft 365 / Entra ID, Apple).
# Leave unset to only show "Continue with Google" on /login.
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_TENANT_ID=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# AI providers — only the one set in DEFAULT_AI_PROVIDER is required at runtime,
# but configuring all three lets AI Assistants pick the best model per task.
DEFAULT_AI_PROVIDER="anthropic" # anthropic | openai | gemini
ANTHROPIC_API_KEY=""
# Also required for AI image generation (storyboard shot reference images,
# poster concept art, project cover images — lib/ai/image-generation-service.ts)
# and Video Academy narration audio (lib/ai/video-narration-service.ts)
# regardless of DEFAULT_AI_PROVIDER, since Claude doesn't generate images or speech.
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Cloudinary (direct-to-cloud video upload for student submissions,
# on-the-fly video-frame thumbnails used by AI Video Review, and hosting
# for AI-generated images from lib/ai/image-generation-service.ts)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# LMS integrations beyond Google Classroom (all optional — a school only
# configures the ones it actually uses). See /admin/dashboard/integrations.
CANVAS_BASE_URL="" # e.g. https://yourschool.instructure.com
CANVAS_CLIENT_ID=""
CANVAS_CLIENT_SECRET=""
SCHOOLOGY_CLIENT_ID=""
SCHOOLOGY_CLIENT_SECRET=""
BLACKBOARD_BASE_URL="" # e.g. https://yourschool.blackboard.com
BLACKBOARD_APP_KEY=""
BLACKBOARD_APP_SECRET=""

# Video hosting integrations for publishing student work (optional).
# YouTube reuses GOOGLE_CLIENT_ID/SECRET above with an upload scope.
VIMEO_CLIENT_ID=""
VIMEO_CLIENT_SECRET=""
ADOBE_CLIENT_ID="" # Frame.io, via Adobe's shared IMS OAuth
ADOBE_CLIENT_SECRET=""
FRAME_IO_ACCOUNT_ID=""
FRAME_IO_ROOT_FOLDER_ID=""

# Infinite Campus (Student Information System) credentials are configured
# per-organization at /admin/dashboard/integrations, not via env vars —
# each district issues its own API key/secret for its own Campus instance.

# Gamma (presentation export). PDF/Word/PowerPoint export need no external
# API — only Gamma export requires this key.
GAMMA_API_KEY=""

# Sentry (error reporting). Leave unset in local dev/CI — the SDK safely
# no-ops without a DSN. SENTRY_AUTH_TOKEN is only needed to upload source
# maps during a production build (set it in CI/Vercel, not locally).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
