// Film Studio Classroom AI — core data model.
// Postgres via Supabase. This schema covers Phase 1: identity, standards,
// curriculum/project generation, and equipment. Portfolio, SkillsUSA, and
// billing models land in later phases (see ROADMAP.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase's pooled connection (pgbouncer, port 6543) — used for every
  // runtime query, since serverless functions open far more connections
  // than a direct Postgres connection limit tolerates.
  url       = env("DATABASE_URL")
  // Supabase's direct connection (port 5432) — `prisma migrate` needs a
  // real Postgres connection (advisory locks, DDL) that pgbouncer's
  // transaction pooling mode doesn't support. Local dev points both at
  // the same local Postgres instance.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  TEACHER
  ADMIN
  PARENT
  MENTOR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(STUDENT)
  /// Deactivating a user keeps their history (submissions, grades,
  /// attendance) intact but blocks sign-in — see middleware.ts. Preferred
  /// over deleting or nulling organizationId, which would orphan or
  /// destroy that history.
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  teacherOf      ClassPeriod[]       @relation("TeacherClasses")
  enrollments    Enrollment[]
  parentLinks    ParentLink[]        @relation("ParentUser")
  studentLinks   ParentLink[]        @relation("StudentUser")
  submissions    Submission[]
  equipmentLoans EquipmentCheckout[]
  portfolio      PortfolioItem[]
  generationJobs AIGenerationJob[]
  invitesSent    Invite[]            @relation("InviteCreatedBy")

  attendanceAsStudent AttendanceRecord[]  @relation("StudentAttendance")
  attendanceRecorded  AttendanceRecord[]  @relation("AttendanceRecordedBy")
  messagesSent        TeacherMessage[]    @relation("TeacherMessageSentBy")
  tutorMessages       TutorMessage[]
  tutorialVideos      TutorialVideo[]
  assistantMessages   AssistantMessage[]
  filmStudioProjects  FilmStudioProject[]
  skillsUsaPractices  SkillsUsaPractice[]

  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ParentLink {
  id        String @id @default(cuid())
  parentId  String
  studentId String

  parent  User @relation("ParentUser", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentUser", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  district  String?
  cdsCode   String? // California school code, for CTE reporting
  createdAt DateTime @default(now())

  users              User[]
  classPeriods       ClassPeriod[]
  equipment          EquipmentItem[]
  integrationLinks   IntegrationConnection[]
  invites            Invite[]
  tutorialVideos     TutorialVideo[]
  filmStudioProjects FilmStudioProject[]
  skillsUsaPractices SkillsUsaPractice[]
}

/// Invite-based onboarding. Roles are never self-assigned beyond the
/// least-privilege STUDENT default (see User.role) — every promotion to
/// TEACHER/ADMIN/MENTOR, and every parent-to-student link, happens through
/// a token an existing org member issued, not by a user claiming it
/// themselves. See lib/invites.ts.
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role
  token          String    @unique
  /// Required and only meaningful when role = PARENT: the existing student
  /// User this invite links the parent to once accepted.
  studentId      String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InviteCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([email])
}

model ClassPeriod {
  id             String   @id @default(cuid())
  name           String
  period         String?
  gradeLevel     String // "9" | "10" | "11" | "12" | "ADULT" | "COLLEGE"
  pathway        String   @default("Production and Managerial Arts")
  organizationId String
  teacherId      String
  createdAt      DateTime @default(now())
  /// Set when an admin imports this class period's roster from a Google
  /// Classroom course (see lib/roster-sync.ts) — lets "push to Classroom"
  /// on a generated project find the right course without asking again.
  googleClassroomCourseId String?

  organization Organization       @relation(fields: [organizationId], references: [id])
  teacher      User               @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments  Enrollment[]
  projects     Project[]
  attendance   AttendanceRecord[]
  messages     TeacherMessage[]

  @@index([organizationId])
  @@index([teacherId])
}

model Enrollment {
  id            String   @id @default(cuid())
  studentId     String
  classPeriodId String
  createdAt     DateTime @default(now())

  student     User        @relation(fields: [studentId], references: [id])
  classPeriod ClassPeriod @relation(fields: [classPeriodId], references: [id])

  @@unique([studentId, classPeriodId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  TARDY
  EXCUSED
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  classPeriodId String
  studentId     String
  date          DateTime         @db.Date
  status        AttendanceStatus
  notes         String?
  recordedById  String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  classPeriod ClassPeriod @relation(fields: [classPeriodId], references: [id])
  student     User        @relation("StudentAttendance", fields: [studentId], references: [id])
  recordedBy  User        @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([classPeriodId, studentId, date])
  @@index([classPeriodId, date])
}

// ---------------------------------------------------------------------------
// California Standards Engine
// ---------------------------------------------------------------------------

enum StandardFramework {
  CA_CTE_AME
  CA_VAPA_MEDIA_ARTS
  CA_COMMON_CORE_ELA
  ISTE
  DIGITAL_CITIZENSHIP
  EMPLOYABILITY
}

model Standard {
  id          String            @id @default(cuid())
  framework   StandardFramework
  code        String // e.g. "A2.0" (CTE), "VA:Cr2.1.HSI" (VAPA)
  strand      String?
  description String            @db.Text

  projectStandards ProjectStandard[]
  lessonStandards  LessonStandard[]

  @@unique([framework, code])
}

// ---------------------------------------------------------------------------
// Curriculum: projects and lessons (the PBL weekly cycle)
// ---------------------------------------------------------------------------

enum ProjectCategory {
  COMMERCIAL
  MOVIE_TRAILER
  MUSIC_VIDEO
  DOCUMENTARY
  PSA
  NEWS_BROADCAST
  SPORTS_BROADCAST
  WEATHER_REPORT
  INTERVIEW
  PODCAST
  STOP_MOTION
  ANIMATION
  SHORT_FILM
  FEATURE_UNIT
  TRAVEL_VIDEO
  PRODUCT_VIDEO
  YOUTUBE_VIDEO
  SOCIAL_VIDEO
  VERTICAL_VIDEO
  EXPERIMENTAL
  HORROR
  COMEDY_GENRE
  SCI_FI
  MYSTERY
  WESTERN
  FILM_NOIR
  HISTORICAL
  GREEN_SCREEN
  VIRTUAL_PRODUCTION
  MULTI_CAM_STUDIO
  LIVE_STREAM
  DRONE
  VIDEO_360
  VR_PRODUCTION
  AR_PRODUCTION
}

enum ProjectStatus {
  DRAFT
  GENERATING
  READY
  ARCHIVED
}

/// A Project is one full PBL week (Mon launch -> Fri showcase). Generating a
/// Project cascades into every artifact below via the AI curriculum service
/// (see lib/ai/curriculum-service.ts).
model Project {
  id            String          @id @default(cuid())
  title         String
  category      ProjectCategory
  status        ProjectStatus   @default(DRAFT)
  classPeriodId String
  weekOf        DateTime?
  brief         String          @db.Text // the generating prompt/brief
  /// Set after a successful Gamma export (lib/export/gamma.ts) so the UI
  /// can link back to it without regenerating. Null until exported.
  gammaUrl      String?
  /// Set after a successful Google Docs export (lib/export/google-docs.ts).
  googleDocUrl  String?
  /// Set after this project's teacher guide has been pushed as a Google
  /// Classroom assignment (lib/integrations/google-classroom.ts).
  classroomUrl  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  classPeriod ClassPeriod @relation(fields: [classPeriodId], references: [id])

  lessons        Lesson[]
  rubric         Rubric?
  quiz           Quiz?
  vocabulary     VocabularyTerm[]
  storyboard     Storyboard?
  productionPlan ProductionPlan?
  standards      ProjectStandard[]
  submissions    Submission[]
  generationJob  AIGenerationJob?
  portfolioItems PortfolioItem[]

  @@index([classPeriodId])
}

model ProjectStandard {
  id         String @id @default(cuid())
  projectId  String
  standardId String

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id])

  @@unique([projectId, standardId])
}

enum LessonDay {
  MONDAY_LAUNCH
  TUESDAY_PREPRODUCTION
  WEDNESDAY_PRODUCTION
  THURSDAY_EDITING
  FRIDAY_SHOWCASE
}

model Lesson {
  id              String    @id @default(cuid())
  projectId       String
  day             LessonDay
  title           String
  objective       String    @db.Text
  iCanStatement   String    @db.Text
  agenda          Json // structured agenda blocks (hook, direct instruction, activity, etc.)
  slidesUrl       String?
  worksheet       Json? // structured worksheet content, exportable to PDF/Docx
  differentiation Json? // { accommodations: string[], extensions: string[], interventions: string[] }
  createdAt       DateTime  @default(now())

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  standards LessonStandard[]

  @@unique([projectId, day])
}

model LessonStandard {
  id         String @id @default(cuid())
  lessonId   String
  standardId String

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  standard Standard @relation(fields: [standardId], references: [id])

  @@unique([lessonId, standardId])
}

model Rubric {
  id        String @id @default(cuid())
  projectId String @unique
  title     String
  criteria  Json // CriterionReferencedRubric shape: [{ name, levels: [{label, points, description}] }]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Quiz {
  id        String @id @default(cuid())
  projectId String @unique
  title     String
  questions Json // [{ prompt, type, choices?, answer, standardCode? }]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model VocabularyTerm {
  id         String @id @default(cuid())
  projectId  String
  term       String
  definition String @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Storyboard {
  id          String @id @default(cuid())
  projectId   String @unique
  visualTheme Json // { palette, lighting, lensCharacter, aesthetic }
  shots       Json // [{ number, description, shotType, movement, lighting, audio, durationSec }]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProductionPlan {
  id            String @id @default(cuid())
  projectId     String @unique
  callSheet     Json
  crewRoles     Json // [{ role, studentId?, responsibilities }]
  equipmentList Json // [{ itemType, quantity }]
  schedule      Json // shot-by-shot timeline for Wednesday production day

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Assessment & submissions
// ---------------------------------------------------------------------------

enum SubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  GRADED
}

model Submission {
  id          String           @id @default(cuid())
  projectId   String
  studentId   String
  status      SubmissionStatus @default(NOT_STARTED)
  videoUrl    String?
  reflection  String?          @db.Text
  peerReview  Json?
  selfAssess  Json?
  grade       Json? // { rubricScores: Record<string, number>, total, feedback }
  aiReview    Json? // structured AI video review output
  submittedAt DateTime?
  createdAt   DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id])

  @@unique([projectId, studentId])
}

/// A message a teacher sends to the parents of every student enrolled in a
/// class period. Recipients are derived at read time (ParentLink ->
/// student -> enrollment -> classPeriod), not persisted per-recipient, so
/// adding/removing a student's parent link automatically changes who sees
/// past messages. Delivery today is in-app only (parent dashboard); real
/// email/SMS delivery is an integration concern (ROADMAP.md Phase 10).
model TeacherMessage {
  id            String   @id @default(cuid())
  classPeriodId String
  sentById      String
  subject       String
  body          String   @db.Text
  createdAt     DateTime @default(now())

  classPeriod ClassPeriod @relation(fields: [classPeriodId], references: [id], onDelete: Cascade)
  sentBy      User        @relation("TeacherMessageSentBy", fields: [sentById], references: [id])

  @@index([classPeriodId])
}

// ---------------------------------------------------------------------------
// Equipment management
// ---------------------------------------------------------------------------

enum EquipmentCategory {
  CAMERA
  LENS
  LIGHTING
  AUDIO
  DRONE
  TRIPOD
  GIMBAL
  SD_CARD
  BATTERY
  OTHER
}

model EquipmentItem {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  category       EquipmentCategory
  assetTag       String            @unique // QR/RFID code payload
  status         String            @default("AVAILABLE") // AVAILABLE | CHECKED_OUT | DAMAGED | RETIRED

  organization Organization        @relation(fields: [organizationId], references: [id])
  checkouts    EquipmentCheckout[]

  @@index([organizationId])
}

model EquipmentCheckout {
  id           String    @id @default(cuid())
  equipmentId  String
  userId       String
  checkedOutAt DateTime  @default(now())
  dueAt        DateTime?
  returnedAt   DateTime?
  damageNotes  String?

  equipment EquipmentItem @relation(fields: [equipmentId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@index([equipmentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Portfolio
// ---------------------------------------------------------------------------

enum PortfolioItemType {
  PROJECT_ARCHIVE
  CERTIFICATE
  BADGE
  RESUME
  DEMO_REEL
}

model PortfolioItem {
  id        String            @id @default(cuid())
  userId    String
  projectId String?
  type      PortfolioItemType
  title     String
  assetUrl  String?
  metadata  Json?
  createdAt DateTime          @default(now())

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// AI Tutor
// ---------------------------------------------------------------------------

enum ChatRole {
  USER
  ASSISTANT
}

/// One running conversation per student (no separate thread model yet —
/// see ROADMAP.md if multi-thread history becomes necessary). Grounded by
/// lib/ai/tutor-service.ts in the pedagogical principles from
/// skills/education/ai-learning-science/*: progressive hints instead of
/// answers, Socratic scaffolding, and timely specific formative feedback.
model TutorMessage {
  id        String   @id @default(cuid())
  studentId String
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

// ---------------------------------------------------------------------------
// Third-party integrations (adapter framework persistence)
// ---------------------------------------------------------------------------

enum IntegrationProviderType {
  GOOGLE_CLASSROOM
  CANVAS
  SCHOOLOGY
  BLACKBOARD
  /// Student Information System, not an LMS — see lib/integrations/sis-adapter.ts.
  /// District-provisioned API access, not self-serve OAuth app registration.
  INFINITE_CAMPUS
  GOOGLE_WORKSPACE
  MICROSOFT_365
  ADOBE_CREATIVE_CLOUD
  YOUTUBE
  VIMEO
  /// Adobe's video review/collaboration product — see lib/integrations/video-host-adapter.ts.
  FRAME_IO
  ZAPIER
  SLACK
}

model IntegrationConnection {
  id             String                  @id @default(cuid())
  organizationId String
  provider       IntegrationProviderType
  accessToken    String?                 @db.Text
  refreshToken   String?                 @db.Text
  expiresAt      DateTime?
  scopes         String[]
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
}

// ---------------------------------------------------------------------------
// AI generation jobs (audit trail + async status for the curriculum engine)
// ---------------------------------------------------------------------------

enum AIJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AIGenerationJob {
  id            String      @id @default(cuid())
  projectId     String?     @unique
  requestedById String
  status        AIJobStatus @default(QUEUED)
  input         Json
  output        Json?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())

  project     Project? @relation(fields: [projectId], references: [id])
  requestedBy User     @relation(fields: [requestedById], references: [id])
}

// ---------------------------------------------------------------------------
// Video Academy
// ---------------------------------------------------------------------------

enum TutorialCategory {
  CAMERA_OPERATION
  LIGHTING
  AUDIO
  EDITING
  DIRECTING
  SCREENWRITING
  BROADCAST_JOURNALISM
  ANIMATION
  SAFETY
  CAREER
  OTHER
}

/// A standalone instructional tutorial (distinct from a Project's weekly
/// lesson cycle) — the org's shared library of how-to videos. `segments`
/// hold the AI-generated narration/visual-guide/shot-list content;
/// transcript and captionsSrt are deterministically derived from segments
/// by lib/captions.ts rather than generated separately, so they can never
/// drift out of sync with the narration.
model TutorialVideo {
  id                String           @id @default(cuid())
  organizationId    String
  createdById       String
  title             String
  topic             String
  category          TutorialCategory
  learningObjective String           @db.Text
  teacherScript     String           @db.Text
  segments          Json // [{ startSeconds, endSeconds, narration, visualGuide, shotType?, graphicsNote?, animationSuggestion? }]
  practiceActivity  Json // { title, instructions, estimatedMinutes }
  quiz              Json // { title, questions: [...] } — same shape as Quiz.questions
  transcript        String           @db.Text
  captionsSrt       String           @db.Text
  /// Set after a successful Gamma export (lib/export/gamma.ts).
  gammaUrl          String?
  createdAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// AI Assistants (Director AI, Producer AI, Screenwriter AI, ...)
// ---------------------------------------------------------------------------

/// Chat history for the named AI Assistants (see lib/ai/assistants.ts for
/// the registry of personas + system prompts). One row per turn, scoped by
/// (userId, assistantId) — a teacher and a student each get their own
/// conversation with e.g. "director", and the same user's conversations
/// with different assistants don't mix. Distinct from TutorMessage: the
/// AI Tutor is a single pedagogy-grounded coaching surface for students;
/// these are the production-role personas any user can consult.
model AssistantMessage {
  id          String   @id @default(cuid())
  userId      String
  /// Matches an id in lib/ai/assistants.ts's ASSISTANTS registry (e.g. "director", "career-coach").
  assistantId String
  role        ChatRole
  content     String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, assistantId, createdAt])
}

// ---------------------------------------------------------------------------
// AI Film Studio
// ---------------------------------------------------------------------------

/// Standalone production-planning package — unlike Project (tied to a
/// ClassPeriod's Mon-Fri PBL cycle), a FilmStudioProject can back a film
/// festival entry, an extracurricular shoot, or any production a teacher
/// or mentor is planning independent of a specific class assignment.
model FilmStudioProject {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  title          String
  logline        String   @db.Text
  genre          String
  screenplay     Json // { scenes: [{ sceneNumber, heading, action, dialogue: [{character, line}] }] }
  shotList       Json // { shots: [{ number, sceneNumber, description, shotType, lens, movement, durationSeconds }] }
  callSheet      Json // { shootDate, generalCallTime, location, weather?, cast: [...], crew: [...], notes }
  budget         Json // { lineItems: [{ category, item, estimatedCost, notes }], totalEstimate }
  equipmentList  Json // [{ itemType, quantity, notes }]
  locationPlan   Json // [{ name, address?, notes, permitsNeeded }]
  castingSheet   Json // [{ character, description, notes }]
  marketingPlan  Json // { targetAudience, keyMessages: [], channels: [], posterConcept, trailerConcept }
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// SkillsUSA Mode
// ---------------------------------------------------------------------------

/// Competition-practice package for a SkillsUSA contest area. `contestName`
/// is free text rather than a fixed enum deliberately — SkillsUSA's exact
/// roster of contest names/formats changes and varies by state, so we
/// don't hardcode a list we can't guarantee is current and accurate.
model SkillsUsaPractice {
  id                      String   @id @default(cuid())
  organizationId          String
  createdById             String
  contestName             String
  competitionOverview     String   @db.Text
  timedChallenge          Json // { title, scenario, timeLimitMinutes, deliverable, constraints: [] }
  rubric                  Json // { title, criteria: [...] } — same shape as lib/ai/schemas.ts rubricSchema, teacher-facing formative rubric
  judgeSheet              Json // { criteria: [{ name, maxPoints, guidance }], totalPossiblePoints } — competition-day scoring sheet
  mockCompetitionSchedule Json // [{ time, activity }]
  scenarioBank            Json // [{ title, prompt }] — extra practice scenarios beyond the timed challenge
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}
